# Скопируйте этот файл в .env.local и вставьте ключ fal.ai (https://fal.ai/dashboard/keys).
# Файл .env.local не попадает в браузер и не должен попадать в git.
FAL_KEY=

# Необязательные настройки (значения по умолчанию указаны):
# FAL_ENABLED=true          # false: аварийно выключить генерацию
# FAL_MOCK=0                # 1: тестовый режим без обращения к fal.ai и без расходов
# FAL_DAILY_LIMIT=100       # картинок в день на весь сервер
# FAL_HOURLY_PER_IP=8       # запросов в час с одного адреса
# FAL_SESSION_LIMIT=4       # картинок на один урок (первая + правки)
# FAL_MAX_CONCURRENT=3      # одновременных запросов
# FAL_MODEL=fal-ai/nano-banana
# FAL_EDIT_MODEL=fal-ai/nano-banana/edit
# FAL_COST_PER_IMAGE=0.039  # для оценки расходов, USD
