{
  "name": "ai-creator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test:scenarios": "tsx scripts/scenarios.ts && tsx scripts/scenarios2.ts",
    "test:server": "tsx scripts/server-tests.ts && tsx scripts/store-tests.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server-dist/index.mjs",
    "start": "node server-dist/index.mjs",
    "build:api": "mkdir -p api && esbuild serverless/entry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/generate.js && cp api/generate.js api/status.js"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@fontsource-variable/inter": "^5.1.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "fengari": "^0.1.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
